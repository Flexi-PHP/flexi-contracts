{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flexi:contracts:configuration:v1:routes",
  "title": "Flexi routes configuration",
  "type": "object",
  "required": ["routes"],
  "additionalProperties": false,
  "properties": {
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "controller", "method"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "overrides": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1, "pattern": "^/"},
          "controller": {"type": "string", "minLength": 1},
          "method": {"type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD", "TRACE", "CONNECT"]},
          "parameters": {"type": "array", "items": {"type": "object", "required": ["name"], "additionalProperties": false, "properties": {"name": {"type": "string", "minLength": 1}, "required": {"type": "boolean", "default": false}}}},
          "middlewares": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
